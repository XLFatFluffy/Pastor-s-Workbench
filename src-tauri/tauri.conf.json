{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pastor's Workbench",
  "version": "0.12.8",
  "identifier": "com.pastorsworkbench.desktop",
  "build": {
    "frontendDist": "../frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Pastor's Workbench",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "decorations": true,
        "scrollBarStyle": "default"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    },
    "icon": [
      "icons/icon.ico",
      "icons/icon.png",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/256x256.png"
    ],
    "publisher": "Pastor's Workbench"
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDZFRkVEMjUzNTVBQTk2ODgKUldTSWxxcFZVOUwrYm5rbHdJSmRmcGdhYUdSNWMweTZ2eWVGRnloL3F2Q09aaFBxVXV1NFRzR2UK",
      "endpoints": [
        "https://github.com/XLFatFluffy/Pastor-s-Workbench/releases/latest/download/latest.json"
      ]
    }
  }
}
